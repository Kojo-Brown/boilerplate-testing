# Install-time gates. These make `pnpm install` fail rather than warn, so the
# CI matrix in .github/workflows/ci.yml can honestly claim "no warnings".
#
# engine-strict: refuse to install on a Node major outside `engines.node`.
# Without it the field is advisory and a contributor on an unsupported runtime
# gets a confusing failure three gates later instead of at install.
engine-strict=true

# strict-dep-builds: pnpm 10 blocks dependency lifecycle scripts by default and
# prints a warning listing the ones it skipped. That warning is the difference
# between "we decided not to build this" and "nobody looked". Promoting it to
# ERR_PNPM_IGNORED_BUILDS forces every new dependency with a postinstall to be
# triaged into `pnpm.onlyBuiltDependencies` in package.json before it can land.
strict-dep-builds=true
