node_modules/
dist/
storybook-static/
coverage/
playwright-report/
playwright-results/
.playwright/
.auth/
*.tgz

# Playwright's component-test bundle: the Vite build of `ct/index.html` and
# every registered component, rebuilt by `pnpm test:ct` whenever a source file
# under `ct/` changes.
ct/.cache/

# macOS
.DS_Store

# Mutation testing. `.stryker-tmp/` is the sandbox copy of the repository
# Stryker mutates in; `reports/` is where its JSON report is written. Both are
# regenerated by `pnpm mutation:check` and neither is small.
.stryker-tmp/
reports/

# Generated by the consumer contract suites (`pnpm pact:consumer`). The pact is
# a build artefact of the consumer, not a source file: committing it is the
# `files-stale` wiring that pact/README.md measures.
pacts/

# Lighthouse CI's output: the reports for each run, and the
# `assertion-results.json` that `pnpm lighthouse:comment` reads. Regenerated by
# `pnpm lighthouse:ci`, and three HTML reports per URL is not small.
.lighthouseci/

# The Vitest JSON report `pnpm test:quarantine` writes. A build artefact of a
# run that is informational by design, and the first version of the config that
# claimed to write it wrote nothing at all — see flake/README.md.
quarantine-results/

# Attempt records written by `flake/reporter.ts`, one file per run, and the
# Playwright reports collected alongside them. This is the history
# `pnpm flake:check` computes a flake rate from: in CI it is assembled from the
# artifacts of recent runs, and locally it is whatever the last run left here.
.flake/

# Playwright's default output directory. Nothing in this repository writes here
# — every config sets its own `outputDir` or is given `--output` — but a bare
# `playwright test` run from a shell will, and the directory then sits in
# `git status` looking like a source change.
test-results/

# Copies of impact/fixture that a measured run applies a fault to. See impact/README.md.
impact/.runs/

# The selection `pnpm impact:check` writes for `pnpm impact:run`. Derived from a diff.
impact/selection.txt
