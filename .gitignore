# Playwright's component-test bundle: the Vite build of `ct/index.html` and
# every registered component, rebuilt by `pnpm test:ct` whenever a source file
# under `ct/` changes.
ct/.cache/

# macOS
.DS_Store

# Mutation testing. `.stryker-tmp/` is the sandbox copy of the repository
# Stryker mutates in; `reports/` is where its JSON report is written. Both are
# regenerated by `pnpm mutation:check` and neither is small.
.stryker-tmp/
reports/

# Generated by the consumer contract suites (`pnpm pact:consumer`). The pact is
# a build artefact of the consumer, not a source file: committing it is the
# `files-stale` wiring that pact/README.md measures.
pacts/
