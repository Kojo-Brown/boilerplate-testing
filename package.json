{
  "name": "boilerplate-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quarantine": "QUARANTINE=1 vitest run --config vitest/quarantine.config.ts",
    "test:e2e": "playwright test",
    "test:pact": "vitest run --config pact/vitest.config.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "storybook build",
    "lint": "eslint . --max-warnings 0",
    "scan:secrets": "npx gitleaks detect --source . --config .gitleaks.toml --verbose",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook",
    "lighthouse:ci": "lhci autorun --config=lighthouse/lighthouserc.cjs",
    "bundlesize:check": "node bundlesize/check.js"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.14.0",
    "@pact-foundation/pact": "^13.0.0",
    "@playwright/test": "^1.52.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@storybook/test-runner": "^0.24.4",
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/k6": "^0.54.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "axe-core": "^4.10.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^26.0.0",
    "msw": "^2.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.2.0",
    "react-router": "^7.0.0",
    "storybook": "^10.5.5",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  }
}
