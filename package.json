{
  "name": "boilerplate-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quarantine": "QUARANTINE=1 vitest run --config vitest/quarantine.config.ts",
    "test:e2e": "playwright test",
    "test:ct": "playwright test --config ct/playwright-ct.config.ts",
    "pact:consumer": "vitest run --config pact/vitest.config.ts pact/consumer",
    "pact:verify": "vitest run --config pact/vitest.config.ts pact/provider pact/pipeline pact/broker",
    "test:pact": "pnpm pact:consumer && pnpm pact:verify",
    "test:pact:broker": "pnpm pact:consumer && vitest run --config pact/vitest.broker.config.ts",
    "test:containers": "vitest run --config containers/vitest.config.ts",
    "coverage": "vitest run --coverage",
    "shape:check": "node shape/check.ts",
    "snapshot:check": "node snapshot/check.ts",
    "mutation:check": "node mutation/check.ts",
    "characterise:record": "node tdd/characterisation/record.ts",
    "fuzz:record": "node fuzz/record.ts",
    "containers:prune": "node containers/prune.ts",
    "typecheck": "tsc --noEmit",
    "build": "storybook build",
    "lint": "eslint . --max-warnings 0",
    "scan:secrets": "npx gitleaks detect --source . --config .gitleaks.toml --verbose",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook",
    "lighthouse:ci": "lhci autorun --config=lighthouse/lighthouserc.cjs",
    "bundlesize:check": "node bundlesize/check.js"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.14.0",
    "@pact-foundation/pact": "^13.0.0",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "^1.52.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@storybook/test-runner": "^0.24.4",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tanstack/react-query": "^5.101.2",
    "@testcontainers/kafka": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/k6": "^0.54.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^3.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "^4.10.0",
    "eslint": "^10.8.0",
    "fast-check": "4.9.0",
    "globals": "^17.8.0",
    "ioredis": "^6.0.0",
    "jsdom": "^26.0.0",
    "kafkajs": "^2.2.4",
    "msw": "^2.8.0",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.2.0",
    "react-router": "^7.0.0",
    "storybook": "^10.5.5",
    "supertest": "^7.0.0",
    "testcontainers": "12.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msw",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "storybook@10.5.5": "patches/storybook@10.5.5.patch",
      "http-proxy@1.18.1": "patches/http-proxy@1.18.1.patch"
    },
    "ignoredBuiltDependencies": [
      "cpu-features",
      "protobufjs",
      "ssh2"
    ]
  }
}
