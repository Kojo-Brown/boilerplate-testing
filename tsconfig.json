{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    // @reduxjs/toolkit 2.12.0 ships .d.mts files that do not compile under
    // TypeScript 6 (AsyncThunkConfig constraint + TaskAbortError). Both
    // versions are pinned by CLAUDE.md, so the only way to typecheck our own
    // sources is to stop checking third-party declarations. This does not
    // relax any rule applied to this repo's code.
    "skipLibCheck": true,
    // Nothing here is compiled: Vitest and Vite transpile at run time, and this
    // config exists to typecheck. Stating it in the file rather than relying on
    // `tsc --noEmit` is what lets `allowImportingTsExtensions` be set below.
    "noEmit": true,
    // `tdd/conventions/eslint-plugin/` is imported by `eslint.config.js`, which
    // Node loads directly — so its intra-package imports have to carry the
    // `.ts` extension Node's resolver requires. Everything else in the repo is
    // loaded through Vite and keeps the extensionless form.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // No `baseUrl`: it is deprecated in TS 6 (TS5101) and removed in TS 7.
    // `paths` without a `baseUrl` resolves relative to this file, which is
    // exactly the behaviour `"baseUrl": "."` was providing here.
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // `.stryker-tmp` and `reports` are Stryker's. The sandbox is a full copy of
  // this repository, so a crashed run would otherwise have `tsc` checking every
  // file twice and reporting each error from a path nobody edits.
  "exclude": [
    "node_modules",
    ".stryker-tmp",
    "reports",
    "k6/load-test.ts",
    "k6/metrics.ts",
    "bundlesize/check.ts"
  ]
}
